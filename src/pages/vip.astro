---
import Base from '../layouts/Base.astro';
import BotaoDirect from '../components/BotaoDirect.astro';
import { servidor, vip, chancesOvo, chanceGaiola, chancesProvisorias } from '../data/servidor';

const maior = Math.max(...chancesOvo.map((c) => c.chance));
const pct = (n: number) => `${String(n).replace('.', ',')}%`;

const vantagens = [
  { v: 'FLY', t: 'Voo', d: 'No Spawn, no Mundo 1 e no Minerar. Não funciona no Nether, no The End nem em combate.', cmd: '/fly' },
  { v: '0s', t: 'Teleporte na hora', d: 'Todo teleporte é instantâneo, inclusive em combate. O jogador comum espera 3 segundos parado.' },
  { v: '∞', t: 'Homes sem limite', d: 'Salve quantos pontos quiser. O jogador comum fica em 10.' },
  { v: '∞', t: 'Lojas de placa', d: 'Crie lojas de baú e placa sem limite. Só VIP pode criar.' },
  { v: '24H', t: 'Kit VIP', d: 'Espada, picareta, machado e pá de diamante, 8 maçãs douradas, 16 frascos de experiência, bancada e fornalha.', cmd: '/kit vip' },
  { v: 'ON/OFF', t: 'PvP do seu jeito', d: 'Ligue e desligue o próprio PvP fora do Spawn e fora de combate, com 3 minutos entre trocas.', cmd: '/pvp off' },
];
---
<Base titulo="VIP" descricao="Vantagens do VIP do Invictus, pré-venda, como funciona o código e o mercado de VIP.">
  <section class="container topo">
    <div class="topo-txt">
      <span class="hud"><span class="ponto"></span>{servidor.preLancamento ? `Pré-venda até ${servidor.lancamentoCurto}` : 'VIP Invictus'}</span>
      <h1 class="t-titulo t-h1 t-brilho">{servidor.preLancamento ? 'VIP antecipado' : 'VIP Invictus'}</h1>
      <p class="lead">O VIP chega como um código. Você ativa para você ou vende para outro jogador por Coins.</p>
      {servidor.preLancamento && (
        <div class="bonus-box">
          <b>Bônus de quem compra na pré-venda</b>
          {vip.bonusPreVenda.length ? (
            <ul>{vip.bonusPreVenda.map((b) => <li>{b}</li>)}</ul>
          ) : (
            <span>Anúncio em breve no Instagram e no TikTok @{servidor.instagram}.</span>
          )}
        </div>
      )}
    </div>
    <div class="preco mira">
      <div class="preco-topo">
        <span class="t-titulo valor">{vip.preco}</span>
        <span>{vip.periodo}</span>
      </div>
      {vip.precoProvisorio && <span class="selo">valor inicial</span>}
      <p>Os dias se somam ao VIP que ainda estiver ativo.</p>
      {servidor.preLancamento ? (
        <>
          <BotaoDirect class="largo" />
          <small>Abre o direct do @{servidor.instagram} com a mensagem "{vip.mensagemDirect}" copiada. É só colar e enviar.</small>
        </>
      ) : (
        <>
          <span class="btn btn-contorno largo" aria-disabled="true">Compra em breve</span>
          <small>A plataforma de venda ainda está sendo escolhida.</small>
        </>
      )}
    </div>
  </section>

  <section class="container secao">
    <div class="cabeca"><span class="hud">Vantagens</span><h2 class="t-titulo t-h2">O que o VIP libera</h2></div>
    <ul class="dados">
      {vantagens.map((v) => (
        <li class="dado">
          <div><h3>{v.t}</h3><p>{v.d}</p>{v.cmd && <span class="cmd">{v.cmd}</span>}</div>
          <span class="dado-valor">{v.v}</span>
        </li>
      ))}
      <li class="dado tag-linha">
        <div><h3>Destaque no servidor</h3><p>Nome em dourado no tab e em cima da cabeça, e a tag VIP dourada no chat.</p></div>
        <span class="chat-mc"><b class="tag-vip">VIP</b> SeuNome: <span>bora minerar?</span></span>
      </li>
    </ul>
  </section>

  <section class="container secao">
    <div class="cabeca"><span class="hud">Como funciona</span><h2 class="t-titulo t-h2">Um código, dois caminhos</h2></div>
    <div class="caminhos">
      <div class="c1"><span class="t-titulo">1</span><h3>Compre o VIP</h3><p>Você recebe um código. Ele vale como dinheiro, então não passe para ninguém.</p></div>
      <div class="c2"><span class="hud">Caminho A</span><h3>Ative para você</h3><p>Com o inventário vazio (a armadura vestida pode ficar), porque os prêmios vão direto para ele. Cada código vale uma vez.</p><span class="cmd">/ativarvip código</span></div>
      <div class="c2"><span class="hud">Caminho B</span><h3>Venda por Coins</h3><p>Coloque à venda no mercado de VIP pelo preço que quiser, sem taxa. O servidor avisa todo mundo.</p><span class="cmd">/vendervip código preço</span></div>
    </div>
  </section>

  {vip.pacote.length > 0 && (
  <section class="container secao">
    <div class="cabeca">
      <span class="hud">Pacote da ativação</span>
      <h2 class="t-titulo t-h2">O que chega no inventário</h2>
      <p>Toda ativação entrega este pacote. Por isso o inventário precisa estar vazio na hora (a armadura vestida pode ficar).</p>
    </div>
    <ul class="dados pacote">
      {vip.pacote.map((p) => (
        <li class="dado"><div><h3>{p.item}</h3><p>{p.detalhe}</p></div><span class="dado-valor">{p.valor}</span></li>
      ))}
    </ul>
    {!vip.promocao.ativa && <p class="promo-nota">Em datas especiais, como Natal e Dia das Crianças, o VIP de promoção também sorteia um ovo de criatura e uma chance de gaiola.</p>}
  </section>
  )}

  {vip.promocao.ativa && (
  <section class="container secao">
    <div class="cabeca">
      <span class="hud"><span class="ponto"></span>{vip.promocao.nome || 'Promoção'}</span>
      <h2 class="t-titulo t-h2">Prêmios da promoção</h2>
      <p>Durante a promoção, cada ativação também dá um sorteio de ovo de criatura e uma chance de ganhar uma gaiola. Prêmios raros são anunciados para o servidor todo.{chancesProvisorias && ' Estes são os valores iniciais e podem mudar.'}</p>
    </div>
    <div class="premios">
      <div class="tabela-chances">
        {chancesOvo.map((c) => (
          <div class="fc">
            <div class="fc-topo"><b style={`color:${c.cor}`}>{c.nome}</b><span>{pct(c.chance)}</span></div>
            <div class="barra"><div style={`background:${c.cor};width:${(c.chance / maior) * 100}%;box-shadow:0 0 12px ${c.cor}`}></div></div>
            <span class="ovos">{c.detalhe ?? c.ovos.map((o, i) => (i === 0 ? o[0].toUpperCase() + o.slice(1) : o)).join(', ')}</span>
          </div>
        ))}
        <div class="fc-topo gaiola"><b>Chance de gaiola (spawner)</b><span>{pct(chanceGaiola)}</span></div>
      </div>
      <div class="simulador mira">
        <span class="hud">Simulador</span>
        <h3 class="t-titulo">Teste a sorte</h3>
        <p>Simula uma ativação com as chances ao lado. Nada aqui vale no jogo.</p>
        <div class="resultado" aria-live="polite">
          <span id="sim-n" hidden></span>
          <b id="sim-ovo">Clique em Ativar para sortear.</b>
          <span id="sim-gaiola"></span>
        </div>
        <button type="button" id="sim-btn" class="btn btn-vermelho">Ativar</button>
      </div>
    </div>
  </section>
  )}

  <section class="container secao">
    <div class="mercado">
      <div class="m-txt">
        <span class="hud">Mercado de VIP</span>
        <h2 class="t-titulo">VIP também se compra com Coins</h2>
        <p>Jogadores compram e vendem VIP entre si, e quem faz a troca é o servidor, sem risco de golpe. Comprar já ativa o VIP, então você precisa do inventário vazio e dos Coins.</p>
      </div>
      <dl>
        <div><dt><span class="cmd">/mercadovip</span></dt><dd>Menu com os VIPs à venda, do mais barato ao mais caro</dd></div>
        <div><dt><span class="cmd">/vendervip código preço</span></dt><dd>Coloca à venda</dd></div>
        <div><dt><span class="cmd">/vendervip cancelar código</span></dt><dd>Tira da venda</dd></div>
        <div><dt><span class="cmd">/vip</span></dt><dd>Menu com todas as vantagens</dd></div>
        <div><dt><span class="cmd">/diasvip</span></dt><dd>Quantos dias faltam</dd></div>
      </dl>
    </div>
  </section>
</Base>

<script define:vars={{ chances: chancesOvo, gaiola: chanceGaiola }}>
  let vezes = 0;
  const sortear = (lista) => lista[Math.floor(Math.random() * lista.length)];
  document.getElementById('sim-btn')?.addEventListener('click', () => {
    vezes++;
    let r = Math.random() * 100;
    let texto = 'Sem ovo desta vez';
    let cor = '#8E8E98';
    for (const c of chances) {
      if (r < c.chance) {
        if (c.ovos.length) {
          let ovo = sortear(c.ovos);
          if (c.pesos) ovo = c.ovos[Math.random() * c.chance < c.pesos[0] ? 0 : 1];
          texto = `${c.nome}: ovo de ${ovo}`;
          cor = c.cor;
        }
        break;
      }
      r -= c.chance;
    }
    const n = document.getElementById('sim-n');
    const ovoEl = document.getElementById('sim-ovo');
    const gaiolaEl = document.getElementById('sim-gaiola');
    if (n) { n.hidden = false; n.textContent = `Ativação nº ${vezes}`; }
    if (ovoEl) { ovoEl.textContent = texto; ovoEl.style.color = cor; ovoEl.style.textShadow = `0 0 18px ${cor}`; }
    if (gaiolaEl) gaiolaEl.textContent = Math.random() * 100 < gaiola ? 'E ganhou uma gaiola!' : 'Sem gaiola.';
  });
</script>

<style>
  .topo { padding-block: 80px 0; display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
  .topo-txt { flex: 999 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 22px; }
  .bonus-box { border-left: 4px solid var(--ouro); background: rgba(255, 170, 0, 0.08); padding: 16px 20px; display: flex; flex-direction: column; gap: 4px; max-width: 620px; }
  .bonus-box b { color: var(--ouro); }
  .bonus-box span, .bonus-box li { color: var(--texto-2); }
  .bonus-box ul { margin: 4px 0 0; padding-left: 18px; }
  .preco { flex: 1 1 340px; max-width: 440px; background: rgba(11, 11, 14, 0.94); border: 2px solid var(--vermelho-jogo); box-shadow: var(--brilho-caixa); padding: clamp(22px, 5vw, 32px); display: flex; flex-direction: column; gap: 16px; }
  .preco-topo { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .valor { font-size: clamp(44px, 12vw, 60px); line-height: 1; text-shadow: var(--brilho); }
  .preco-topo span:last-child { color: var(--texto-2); }
  .selo { align-self: flex-start; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; border: 1px solid var(--texto-3); color: var(--texto-2); padding: 3px 10px; }
  .preco p { color: var(--texto-2); }
  .preco small { color: var(--texto-3); font-size: 14px; text-align: center; }
  .preco :global(.largo) { width: 100%; }

  .tag-linha { grid-column: 1 / -1; border-left-color: var(--ouro) !important; }
  .chat-mc { background: rgba(0, 0, 0, 0.6); padding: 12px 18px; font-size: 18px; font-weight: 500; overflow-wrap: anywhere; }
  .chat-mc span { color: var(--texto-2); }

  .caminhos { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 12px; }
  .c1, .c2 { padding: 28px; display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .c1 { background: var(--vermelho); box-shadow: 0 0 40px rgba(255, 85, 85, 0.3); }
  .c1 .t-titulo { font-size: 44px; line-height: 1; }
  .c1 p { color: #ffe1e1; }
  .c2 { background: rgba(19, 19, 23, 0.92); border: 1px solid var(--linha); }
  .c2 p { color: var(--texto-2); }
  .caminhos h3 { font-size: 21px; font-weight: 700; }

  .premios { display: flex; flex-wrap: wrap; gap: 24px; align-items: stretch; }
  .tabela-chances { flex: 999 1 520px; min-width: 0; background: rgba(19, 19, 23, 0.92); border: 1px solid var(--linha); padding: clamp(22px, 4vw, 32px); display: flex; flex-direction: column; gap: 20px; }
  .fc { display: flex; flex-direction: column; gap: 8px; }
  .fc-topo { display: flex; justify-content: space-between; gap: 16px; font-size: 18px; }
  .fc-topo span { font-family: var(--f-titulo); font-weight: 700; }
  .barra { height: 8px; background: rgba(255, 255, 255, 0.06); overflow: hidden; }
  .barra div { height: 100%; }
  .ovos { color: var(--texto-3); font-size: 15px; }
  .gaiola { border-top: 1px solid var(--linha); padding-top: 18px; }
  .simulador { flex: 1 1 320px; background: rgba(11, 11, 14, 0.94); border: 2px solid var(--vermelho-jogo); box-shadow: var(--brilho-caixa); padding: 30px; display: flex; flex-direction: column; gap: 14px; }
  .simulador h3 { font-size: 28px; }
  .simulador p { color: var(--texto-2); font-size: 16px; }
  .resultado { background: rgba(0, 0, 0, 0.6); border-left: 3px solid var(--vermelho-jogo); padding: 20px; display: flex; flex-direction: column; gap: 6px; min-height: 124px; justify-content: center; }
  .resultado b { font-size: 21px; }
  .resultado span { color: var(--texto-2); }

  .pacote { grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
  .promo-nota { margin-top: 20px; color: var(--texto-3); }

  .mercado { background: rgba(19, 19, 23, 0.92); border: 1px solid var(--linha); padding: clamp(26px, 5vw, 48px); display: flex; flex-wrap: wrap; gap: 40px; }
  .m-txt { flex: 1 1 360px; display: flex; flex-direction: column; gap: 16px; }
  .m-txt h2 { font-size: clamp(26px, 3.2vw, 38px); }
  .m-txt p { color: var(--texto-2); }
  .mercado dl { flex: 1 1 420px; margin: 0; display: flex; flex-direction: column; }
  .mercado dl div { display: flex; justify-content: space-between; gap: 8px 16px; padding: 14px 0; border-bottom: 1px solid var(--linha); flex-wrap: wrap; }
  .mercado dl div:last-child { border-bottom: 0; }
  .mercado dd { margin: 0; color: var(--texto-2); }
</style>
