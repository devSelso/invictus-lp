---
import Base from '../layouts/Base.astro';
import ServidorCard from '../components/ServidorCard.astro';
import BotaoDirect from '../components/BotaoDirect.astro';
import NovidadeCard from '../components/NovidadeCard.astro';
import { servidor, links, vip } from '../data/servidor';
import { novidadesOrdenadas } from '../data/novidades';

const ultimas = (await novidadesOrdenadas()).slice(0, 3);

// Valores reais do servidor, no formato dos cartões do Reels.
const leitura = [
  { valor: '1.8', titulo: 'PvP clássico', texto: 'De dia o Mundo 1 é tranquilo. Quando escurece, o PvP liga. No Nether e no The End ele nunca desliga.' },
  { valor: '∞', titulo: 'Construção protegida', texto: 'Todo bloco que você coloca é seu, sem comando. Baús, portas e fornalhas já nascem trancados.' },
  { valor: '00:00', titulo: 'Recursos novos todo dia', texto: 'O Minerar e o Nether resetam à meia-noite. Todo dia tem minério intocado.' },
  { valor: '10K', titulo: 'Mundo 1 de 10.000 blocos', texto: 'Um mapa de 10.000 × 10.000 para morar, e suas construções ficam para sempre.' },
  { valor: '6H', titulo: 'Dragão que renasce', texto: 'Derrotou o dragão do The End? Seis horas depois ele volta, e o servidor avisa todo mundo.' },
  { valor: '201', titulo: 'Itens na loja', texto: 'A loja do Spawn vende e compra blocos de construção. O mais rico do servidor ganha a tag Magnata.' },
];

const mundos = [
  { nome: 'Spawn', cmd: '/spawn', cor: '#F3F2EE', d: 'Vila medieval flutuante, com a loja do servidor', pvp: 'Sem PvP', reset: 'Fixo' },
  { nome: 'Mundo 1', cmd: '/warp mundo1', cor: '#4E8A3A', d: '10.000 × 10.000 blocos, onde você constrói e mora', pvp: 'PvP à noite', reset: 'Fixo' },
  { nome: 'Minerar', cmd: '/minerar', cor: '#6E6E73', d: '5.000 × 5.000, sem monstros, nada tem dono', pvp: 'PvP à noite', reset: 'Reset 00:00' },
  { nome: 'Nether', cmd: '/warp nether', cor: '#8E2323', d: 'Só entra quem vestir armadura completa de diamante', pvp: 'PvP sempre', reset: 'Reset 00:00' },
  { nome: 'The End', cmd: '/warp end', cor: '#3B2F7A', d: 'Ilha central clássica, dragão no arco', pvp: 'PvP sempre', reset: 'Fixo' },
];

const vantagensVip = [
  'Voo no Spawn, no Mundo 1 e no Minerar',
  'Teleporte na hora, até em combate',
  'Homes sem limite',
  'Lojas de placa sem limite',
  'Kit de diamante a cada 24 horas',
  'Tag VIP dourada no chat',
];

const perguntas = [
  { p: 'Preciso de Minecraft original?', r: 'Não. O servidor aceita original e pirata. No primeiro acesso você cria uma senha com <span class="cmd">/register</span>.' },
  { p: 'Qual versão eu uso?', r: `Minecraft ${servidor.versao}, Java Edition. O IP é <span class="cmd">${servidor.ip}</span>.` },
  { p: 'Quando o servidor abre?', r: `Dia ${servidor.lancamentoTexto}. Até lá dá para garantir o VIP na pré-venda e acompanhar tudo no @${servidor.instagram}.` },
  { p: 'Como protejo minha casa?', r: 'Não precisa fazer nada: todo bloco que você coloca já é seu. O terreno natural não tem dono, então construa o próprio chão.' },
  { p: 'O que acontece quando eu morro?', r: 'Você volta ao Spawn e os itens do inventário caem onde você morreu. Os Coins ficam na conta.' },
];
---
<Base>
  <section class="hero">
    <div class="varredura" aria-hidden="true"></div>
    <div class="container hero-in">
      <div class="hero-txt">
        <span class="hud"><span class="ponto"></span>Servidor encontrado</span>
        <h1 class="t-titulo t-h1 t-brilho">O survival raiz abre dia <span class="vermelho">{servidor.lancamentoCurto}</span></h1>
        <p class="lead">Minecraft {servidor.versao} com o PvP da 1.8, economia em Coins e construção protegida sem comando. Do jeito dos servidores brasileiros de 2010 a 2014.</p>
        <div class="acoes">
          {servidor.preLancamento ? <BotaoDirect /> : <a class="btn btn-vermelho" href="/como-entrar/">Como entrar</a>}
          <a class="btn btn-contorno" href={servidor.preLancamento ? '/como-entrar/' : '/vip/'}>{servidor.preLancamento ? 'Como entrar' : 'Ver o VIP'}</a>
        </div>
      </div>
      <div class="hero-card">
        <ServidorCard animar />
      </div>
    </div>
  </section>

  <section class="container secao">
    <div class="cabeca">
      <span class="hud">Leitura do servidor</span>
      <h2 class="t-titulo t-h2">O que te espera lá dentro</h2>
    </div>
    <ul class="dados">
      {leitura.map((l) => (
        <li class="dado">
          <div><h3>{l.titulo}</h3><p>{l.texto}</p></div>
          <span class="dado-valor">{l.valor}</span>
        </li>
      ))}
    </ul>
  </section>

  {servidor.preLancamento && (
    <section class="container secao">
      <div class="pre mira">
        <div class="pre-txt">
          <span class="hud"><span class="ponto"></span>Pré-venda até {servidor.lancamentoCurto}</span>
          <h2 class="t-titulo t-h2 t-brilho">VIP antecipado</h2>
          <p>Garanta o VIP antes da abertura e entre no dia {servidor.lancamentoCurto.split('/')[0]} já voando. {vip.bonusPreVenda.length ? 'Quem compra agora leva também:' : `Quem compra na pré-venda ganha bônus exclusivos, que saem em breve no @${servidor.instagram}.`}</p>
          {vip.bonusPreVenda.length > 0 && <ul class="bonus">{vip.bonusPreVenda.map((b) => <li>{b}</li>)}</ul>}
          <ul class="vantagens">
            {vantagensVip.map((v) => <li>{v}</li>)}
          </ul>
          <div class="preco">
            <span class="t-titulo">{vip.preco}</span><span>{vip.periodo}</span>
            {vip.precoProvisorio && <span class="selo">valor inicial</span>}
          </div>
          <div class="acoes">
            <BotaoDirect />
            <a class="btn btn-contorno" href="/vip/">Ver tudo do VIP</a>
          </div>
          <p class="nota">O botão abre o direct do @{servidor.instagram} e copia a mensagem "{vip.mensagemDirect}". É só colar e enviar.</p>
        </div>
        <div class="contagem" aria-label={`Lançamento dia ${servidor.lancamentoTexto}`}>
          <span class="dias t-titulo" data-dias-num>--</span>
          <span class="dias-rot">dias para abrir</span>
          <span class="data t-titulo">{servidor.lancamentoCurto}</span>
        </div>
      </div>
    </section>
  )}

  <section class="container secao">
    <div class="cabeca">
      <span class="hud">Mundos</span>
      <h2 class="t-titulo t-h2">Cinco mundos, um inventário</h2>
      <p>No jogo, <span class="cmd">/warps</span> abre o menu com todos. Morreu em qualquer um, você volta ao Spawn.</p>
    </div>
    <ul class="mundos">
      {mundos.map((m) => (
        <li>
          <span class="m-icone" style={`background:${m.cor}`}></span>
          <div class="m-txt">
            <div class="m-topo"><h3>{m.nome}</h3><span class="cmd">{m.cmd}</span></div>
            <p>{m.d}</p>
          </div>
          <div class="m-chips">
            <span class:list={['chip', { quente: m.pvp !== 'Sem PvP' }]}>{m.pvp}</span>
            <span class="chip">{m.reset}</span>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="container secao">
    <div class="cabeca">
      <span class="hud">Primeira vez</span>
      <h2 class="t-titulo t-h2">Do launcher ao primeiro kit</h2>
    </div>
    <ol class="passos">
      <li><span class="n t-titulo">1</span><div><h3>Abra a versão 1.8.8</h3><p>No launcher, escolha a 1.8.8 e clique em Jogar.</p></div></li>
      <li><span class="n t-titulo">2</span><div><h3>Adicione o servidor</h3><p>Multijogador, Adicionar servidor, cole <span class="cmd">{servidor.ip}</span>.</p></div></li>
      <li><span class="n t-titulo">3</span><div><h3>Crie sua senha</h3><p><span class="cmd">/register</span> na primeira vez e <span class="cmd">/login</span> nas outras.</p></div></li>
      <li><span class="n t-titulo">4</span><div><h3>Pegue o kit</h3><p><span class="cmd">/tutorial</span> e depois <span class="cmd">/kit nb</span>.</p></div></li>
    </ol>
    <a class="mais" href="/como-entrar/">Guia completo para quem nunca jogou em servidor</a>
  </section>

  <section class="container secao">
    <div class="cabeca linha">
      <div><span class="hud">Novidades</span><h2 class="t-titulo t-h2" style="margin-top:16px">O que mudou</h2></div>
      <a class="mais" href="/novidades/">Ver todas</a>
    </div>
    <div class="novs">
      {ultimas.map((post) => <NovidadeCard post={post} />)}
    </div>
  </section>

  <section class="container secao faq">
    <div class="cabeca"><span class="hud">Dúvidas</span><h2 class="t-titulo t-h2">Perguntas frequentes</h2></div>
    <div class="faq-lista">
      {perguntas.map((q) => (
        <details>
          <summary>{q.p}<span aria-hidden="true"></span></summary>
          <p set:html={q.r} />
        </details>
      ))}
    </div>
  </section>

  <section class="container secao final">
    <h2 class="t-titulo t-brilho">Entra dia <span class="vermelho">{servidor.lancamentoCurto}</span></h2>
    <ServidorCard />
    <p class="ate t-titulo">Te vejo lá</p>
    <p class="redes">Novidades no <a href={links.instagram} target="_blank" rel="noopener">Instagram</a> e no <a href={links.tiktok} target="_blank" rel="noopener">TikTok</a>, @{servidor.instagram}.</p>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--linha); }
  /* A varredura é só uma linha fina, atrás do conteúdo: não passa por cima do texto. */
  .varredura { position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--vermelho-jogo); opacity: 0.35; box-shadow: 0 0 16px 2px rgba(255, 85, 85, 0.35); animation: varrer 4s linear infinite; pointer-events: none; z-index: 0; }
  @keyframes varrer { from { top: 0; opacity: 0; } 10% { opacity: 0.35; } 90% { opacity: 0.35; } to { top: 100%; opacity: 0; } }
  .hero-in { position: relative; z-index: 1; padding-block: clamp(48px, 9vw, 104px); display: flex; flex-wrap: wrap; align-items: center; gap: 48px 64px; }
  .hero-txt { flex: 999 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .hero-txt h1 { max-width: 14ch; }
  .hero-txt .lead { max-width: 52ch; }
  .hero-card { flex: 1 1 340px; display: flex; justify-content: center; }
  @media (min-width: 1000px) { .hero-in { min-height: min(680px, calc(100svh - 108px)); } }

  .pre { display: flex; flex-wrap: wrap; background: rgba(11, 11, 14, 0.94); border: 2px solid var(--vermelho-jogo); box-shadow: 0 0 60px rgba(255, 85, 85, 0.25); }
  .pre-txt { flex: 999 1 480px; min-width: 0; padding: clamp(22px, 5vw, 56px); display: flex; flex-direction: column; gap: 20px; }
  .pre-txt > p { color: var(--texto-2); max-width: 60ch; }
  .vantagens, .bonus { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 10px 24px; }
  .vantagens li, .bonus li { position: relative; padding-left: 20px; font-weight: 500; }
  .vantagens li::before, .bonus li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 8px; height: 8px; background: var(--vermelho-jogo); }
  .bonus li { color: var(--ouro); }
  .bonus li::before { background: var(--ouro); }
  .preco { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .preco .t-titulo { font-size: 40px; }
  .preco > span:nth-child(2) { color: var(--texto-2); }
  .selo { font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; border: 1px solid var(--texto-3); color: var(--texto-2); padding: 3px 10px; }
  .nota { font-size: 14px; color: var(--texto-3); }
  .contagem { flex: 1 1 280px; background: var(--vermelho); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; padding: 48px 24px; text-align: center; }
  .dias { font-size: clamp(80px, 12vw, 160px); line-height: .9; text-shadow: 0 0 40px rgba(255, 255, 255, 0.35); }
  @media (max-width: 600px) { .contagem { padding: 32px 20px; } }
  .dias-rot { font-weight: 700; letter-spacing: 4px; text-transform: uppercase; }
  .data { margin-top: 20px; font-size: 22px; padding: 6px 16px; border: 2px solid var(--branco); }

  .mundos { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .mundos li { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; align-items: center; gap: 12px 20px; padding: 14px; background: rgba(19, 19, 23, 0.92); border: 1px solid var(--linha); }
  .mundos li:hover { border-color: var(--vermelho-jogo); }
  .m-icone { width: 64px; height: 64px; box-shadow: inset 0 0 0 4px rgba(0, 0, 0, 0.25); }
  .m-txt { min-width: 0; }
  @media (max-width: 640px) {
    .mundos li { grid-template-columns: 44px minmax(0, 1fr); align-items: start; }
    .m-icone { width: 44px; height: 44px; }
    .m-chips { grid-column: 2; }
  }
  .m-topo { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .m-topo h3 { font-family: var(--f-titulo); font-weight: 900; font-size: 20px; text-transform: uppercase; }
  .m-txt p { color: var(--texto-2); font-size: 16px; }
  .m-chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .chip { font-size: 13px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; padding: 5px 10px; border: 1px solid var(--linha); color: var(--texto-2); white-space: nowrap; }
  .chip.quente { border-color: rgba(255, 85, 85, 0.5); color: var(--vermelho-jogo); }

  .passos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 12px; }
  .passos li { display: flex; gap: 18px; padding: 24px; background: rgba(19, 19, 23, 0.92); border: 1px solid var(--linha); }
  .n { font-size: 40px; line-height: 1; color: var(--vermelho-jogo); text-shadow: var(--brilho); }
  .passos h3 { font-size: 19px; font-weight: 700; margin-bottom: 6px; }
  .passos p { color: var(--texto-2); font-size: 16px; }
  .mais { display: inline-block; margin-top: 24px; font-weight: 600; letter-spacing: 1px; }
  .cabeca.linha { flex-direction: row; flex-wrap: wrap; align-items: end; justify-content: space-between; max-width: none; }
  .cabeca.linha .mais { margin-top: 0; }

  .novs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 12px; }

  .faq { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 40px; }
  .faq .t-h2 { font-size: clamp(28px, 3vw, 40px); }
  @media (max-width: 860px) { .faq { grid-template-columns: minmax(0, 1fr); gap: 0; } }
  details { border-bottom: 1px solid var(--linha); padding: 22px 0; }
  details:first-child { padding-top: 0; }
  summary { cursor: pointer; list-style: none; font-size: 19px; font-weight: 600; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  summary::-webkit-details-marker { display: none; }
  summary span { width: 14px; height: 14px; flex: none; position: relative; }
  summary span::before, summary span::after { content: ''; position: absolute; background: var(--vermelho-jogo); left: 0; right: 0; top: 6px; height: 2px; transition: transform .2s; }
  summary span::after { transform: rotate(90deg); }
  details[open] summary span::after { transform: rotate(0); }
  details p { margin-top: 12px; color: var(--texto-2); }

  .final { display: flex; flex-direction: column; align-items: center; gap: 32px; text-align: center; }
  .final h2 { font-size: clamp(36px, 7vw, 88px); }
  .final :global(.card) { text-align: left; }
  .ate { font-size: clamp(22px, 3vw, 30px); letter-spacing: 3px; }
  .redes { color: var(--texto-3); }
</style>
