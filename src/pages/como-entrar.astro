---
import Base from '../layouts/Base.astro';
import ServidorCard from '../components/ServidorCard.astro';
import { servidor } from '../data/servidor';

const passos = [
  { t: 'Abra o Minecraft na versão 1.8.8', d: 'O Invictus roda na 1.8.8, a versão do PvP clássico. No launcher, crie ou escolha um perfil com a 1.8.8 e clique em Jogar.' },
  { t: 'Adicione o servidor', d: `Vá em Multijogador e depois em Adicionar servidor. Dê o nome Invictus, cole o IP e confirme. O elmo vermelho aparece na sua lista.`, chat: servidor.ip },
  { t: 'No primeiro acesso, crie sua senha', d: 'Como o servidor aceita Minecraft pirata, sua conta é protegida por senha. Digite a mesma senha duas vezes.', chat: '/register suaSenha suaSenha' },
  { t: 'Nas outras vezes, entre com ela', d: 'Toda vez que voltar ao servidor, use a senha que você criou.', chat: '/login suaSenha' },
  { t: 'Veja o tutorial', d: 'A mensagem de boas-vindas traz atalhos clicáveis. O tutorial explica como o servidor funciona.', chat: '/tutorial' },
  { t: 'Pegue o kit inicial', d: 'Você começa sem itens. O kit Normal traz espada, picareta, machado e pá de madeira, 8 pães, bancada e fornalha, e pode ser pego de novo a cada 24 horas.', chat: '/kit nb' },
];
---
<Base titulo="Como entrar" descricao="Passo a passo para entrar no Invictus: versão 1.8.8, adicionar o servidor, criar sua senha e pegar o primeiro kit.">
  <section class="container topo">
    <div class="topo-txt">
      <span class="hud"><span class="ponto"></span>Guia para iniciantes</span>
      <h1 class="t-titulo t-h1 t-brilho">Como entrar</h1>
      <p class="lead">Nunca jogou em servidor? Em seis passos você sai do launcher e chega ao Spawn com o primeiro kit.</p>
    </div>
    <ServidorCard />
  </section>

  <section class="container">
    <ol class="passos">
      {passos.map((p, i) => (
        <li>
          <span class="n t-titulo">{i + 1}</span>
          <div class="txt"><h2>{p.t}</h2><p>{p.d}</p></div>
          {p.chat && <div class="chat">{p.chat}</div>}
        </li>
      ))}
    </ol>
  </section>

  <section class="container extras">
    <div class="seg mira">
      <span class="hud">Segurança da conta</span>
      <h2 class="t-titulo">Sua senha é só sua</h2>
      <ul>
        <li>Não use a mesma senha de outros servidores.</li>
        <li>Nunca passe sua senha para ninguém.</li>
        <li>A equipe nunca pede sua senha.</li>
      </ul>
    </div>
    <div class="depois">
      <span class="hud">Primeiros minutos</span>
      <h2 class="t-titulo">E depois do kit</h2>
      <ul>
        <li><span class="cmd">/warps</span> mostra todos os mundos com explicação.</li>
        <li><span class="cmd">/minerar</span> leva ao mundo de recursos, sem monstros.</li>
        <li><span class="cmd">/warp mundo1</span> leva ao mundo onde você constrói.</li>
        <li><span class="cmd">/sethome casa</span> salva um ponto, e <span class="cmd">/home casa</span> volta para ele.</li>
      </ul>
      <a href="/regras/">Regras e todos os comandos</a>
    </div>
  </section>
</Base>

<style>
  .topo { padding-block: 80px 64px; display: flex; flex-wrap: wrap; gap: 48px; align-items: center; justify-content: space-between; }
  .topo-txt { flex: 1 1 480px; display: flex; flex-direction: column; gap: 22px; }
  .passos { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .passos li { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 32px; padding: clamp(22px, 3vw, 30px); background: rgba(19, 19, 23, 0.92); border: 1px solid var(--linha); border-left: 4px solid var(--vermelho-jogo); }
  .n { flex: 0 0 56px; font-size: 52px; line-height: 1; color: var(--vermelho-jogo); text-shadow: var(--brilho); }
  .txt { flex: 1 1 360px; display: flex; flex-direction: column; gap: 8px; }
  .txt h2 { font-size: clamp(20px, 2.2vw, 24px); font-weight: 700; }
  .txt p { color: var(--texto-2); }
  .passos .chat { flex: 1 1 280px; }
  .extras { padding-top: 64px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 24px; }
  .seg, .depois { padding: clamp(26px, 4vw, 40px); display: flex; flex-direction: column; gap: 16px; }
  .seg { background: rgba(11, 11, 14, 0.94); border: 2px solid var(--vermelho-jogo); box-shadow: var(--brilho-caixa); }
  .depois { background: rgba(19, 19, 23, 0.92); border: 1px solid var(--linha); }
  .seg h2, .depois h2 { font-size: clamp(24px, 2.6vw, 30px); }
  ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; color: var(--texto-2); }
  li { line-height: 1.6; }
  .seg li, .depois li { position: relative; padding-left: 20px; }
  .seg li::before, .depois li::before { content: ''; position: absolute; left: 0; top: 0.65em; width: 8px; height: 8px; background: var(--vermelho-jogo); }
  .depois a { font-weight: 600; }
</style>
