---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BotaoDirect from '../../components/BotaoDirect.astro';
import { novidadesOrdenadas, nomesTipo, formatarData } from '../../data/novidades';
import { servidor } from '../../data/servidor';

export async function getStaticPaths() {
  const posts = await novidadesOrdenadas();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { titulo, data, tipo, etiqueta, resumo } = post.data;
---
<Base titulo={titulo} descricao={resumo}>
  <article class="container artigo">
    <a href="/novidades/" class="voltar">Todas as novidades</a>
    <div class="meta">
      <span class="etq">{etiqueta ?? nomesTipo[tipo]}</span>
      <time datetime={data.toISOString()}>{formatarData(data)}</time>
    </div>
    <h1 class="t-titulo t-brilho">{titulo}</h1>
    <div class="texto"><Content /></div>
    {servidor.preLancamento && (
      <aside class="chamada mira">
        <div><b>Pré-venda do VIP aberta</b><span>Garanta o seu antes da abertura, dia {servidor.lancamentoTexto}.</span></div>
        <BotaoDirect />
      </aside>
    )}
  </article>
</Base>

<style>
  .artigo { max-width: 820px; padding-block: 64px 0; display: flex; flex-direction: column; gap: 22px; }
  .voltar { font-weight: 600; letter-spacing: 1px; }
  .meta { display: flex; gap: 14px; align-items: center; }
  .etq { font-size: 12px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--vermelho-jogo); }
  time { color: var(--texto-3); }
  h1 { font-size: clamp(30px, 4.6vw, 48px); line-height: 1.1; }
  .texto :global(p), .texto :global(li) { color: var(--texto-2); font-size: 19px; line-height: 1.7; }
  .texto :global(p + p), .texto :global(ul) { margin-top: 14px; }
  .texto :global(ul) { padding-left: 22px; }
  .texto :global(code) { font-family: var(--f-texto); font-weight: 600; color: var(--vermelho-jogo); background: rgba(255, 85, 85, 0.08); border: 1px solid rgba(255, 85, 85, 0.25); padding: 1px 7px; }
  .texto :global(strong) { color: var(--branco); }
  .chamada { margin-top: 28px; background: rgba(11, 11, 14, 0.94); border: 2px solid var(--vermelho-jogo); box-shadow: var(--brilho-caixa); padding: 26px; display: flex; flex-wrap: wrap; gap: 18px; align-items: center; justify-content: space-between; }
  .chamada div { display: flex; flex-direction: column; gap: 4px; }
  .chamada span { color: var(--texto-2); }
</style>
