---
import type { CollectionEntry } from 'astro:content';
import { nomesTipo, formatarData } from '../data/novidades';

interface Props { post: CollectionEntry<'novidades'> }
const { post } = Astro.props;
const { titulo, data, tipo, etiqueta, resumo } = post.data;
---
<a href={`/novidades/${post.id}/`} class="nov">
  <div class="meta">
    <span class={`selo ${tipo === 'lancamento' ? '' : 'selo-grafite'}`}>{etiqueta ?? nomesTipo[tipo]}</span>
    <time datetime={data.toISOString()}>{formatarData(data)}</time>
  </div>
  <h3>{titulo}</h3>
  <p>{resumo}</p>
</a>

<style>
  .nov { text-decoration: none; color: var(--branco); background: var(--fundo-2); border: 1px solid var(--linha); border-radius: 14px; padding: 28px; display: flex; flex-direction: column; gap: 12px; transition: border-color .15s; }
  .nov:hover { border-color: var(--vermelho); color: var(--branco); }
  .meta { display: flex; gap: 10px; align-items: center; }
  time { color: var(--texto-3); font-size: 13px; }
  h3 { font-size: 22px; font-weight: 700; line-height: 1.3; }
  p { color: #b4b4bc; font-size: 15px; line-height: 1.6; }
</style>
