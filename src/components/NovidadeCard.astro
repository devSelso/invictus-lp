---
import type { CollectionEntry } from 'astro:content';
import { nomesTipo, formatarData } from '../data/novidades';

interface Props { post: CollectionEntry<'novidades'> }
const { post } = Astro.props;
const { titulo, data, tipo, etiqueta, resumo } = post.data;
---
<a href={`/novidades/${post.id}/`} class:list={['nov', { destaque: tipo === 'lancamento' }]}>
  <div class="meta">
    <span class="etq">{etiqueta ?? nomesTipo[tipo]}</span>
    <time datetime={data.toISOString()}>{formatarData(data)}</time>
  </div>
  <h3>{titulo}</h3>
  <p>{resumo}</p>
</a>

<style>
  .nov { text-decoration: none; color: var(--branco); background: rgba(19, 19, 23, 0.92); border: 1px solid var(--linha); padding: 26px; display: flex; flex-direction: column; gap: 12px; }
  .nov:hover { border-color: var(--vermelho-jogo); color: var(--branco); }
  .destaque { border-color: rgba(255, 85, 85, 0.6); box-shadow: var(--brilho-caixa); }
  .meta { display: flex; gap: 12px; align-items: center; }
  .etq { font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--vermelho-jogo); }
  time { color: var(--texto-3); font-size: 14px; }
  h3 { font-size: 21px; font-weight: 700; line-height: 1.3; }
  p { color: var(--texto-2); font-size: 16px; }
</style>
