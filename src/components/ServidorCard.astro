---
// O servidor como aparece na lista de servidores do Minecraft, igual ao CTA dos Reels.
import Elmo from './Elmo.astro';
import { servidor } from '../data/servidor';

interface Props { animar?: boolean }
const { animar = false } = Astro.props;
---
<div class:list={['alvo', { animar }]}>
  <div class="card mira branca">
    <div class="icone"><Elmo largura={52} /></div>
    <div class="info">
      <div class="linha1">
        <span class="nome">INVICTUS</span>
        <span class="sinal" aria-label="Sinal bom"><i></i><i></i><i></i><i></i></span>
      </div>
      <span class="desc">Survival · PvP 1.8</span>
      <span class="status">{servidor.preLancamento ? `abre ${servidor.lancamentoCurto}` : 'online'}</span>
    </div>
  </div>
  <button type="button" class="btn btn-vermelho conectar" data-copiar={servidor.ip} data-copiado="IP copiado">Conectar</button>
  <p class="ip">IP <b>{servidor.ip}</b> · versão {servidor.versao} · aceita pirata</p>
</div>

<style>
  .alvo { display: flex; flex-direction: column; gap: 18px; width: 100%; max-width: 460px; }
  .card { display: flex; gap: 18px; align-items: center; padding: 18px; background: rgba(11, 11, 14, 0.92); border: 2px solid var(--vermelho-jogo); box-shadow: var(--brilho-caixa); }
  .icone { width: 92px; height: 92px; flex: none; background: var(--vermelho); display: grid; place-items: center; box-shadow: 0 0 28px rgba(255, 85, 85, 0.45); }
  .info { display: flex; flex-direction: column; gap: 4px; min-width: 0; flex: 1; }
  .linha1 { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .nome { font-family: var(--f-titulo); font-weight: 900; font-size: 26px; color: var(--vermelho-jogo); text-shadow: var(--brilho); letter-spacing: 1px; }
  .sinal { display: flex; align-items: end; gap: 3px; height: 18px; }
  .sinal i { width: 4px; background: var(--vermelho-jogo); }
  .sinal i:nth-child(1) { height: 6px; } .sinal i:nth-child(2) { height: 10px; } .sinal i:nth-child(3) { height: 14px; } .sinal i:nth-child(4) { height: 18px; }
  .desc { color: var(--texto-2); font-weight: 500; }
  .status { color: var(--online); font-weight: 600; font-size: 15px; display: flex; align-items: center; gap: 8px; }
  .status::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--online); box-shadow: 0 0 8px var(--online); }
  .conectar { width: 100%; min-height: 64px; font-size: 20px; letter-spacing: 6px; }
  .ip { text-align: center; color: var(--texto-3); font-size: 14px; letter-spacing: 2px; text-transform: uppercase; }
  .ip b { color: var(--branco); font-weight: 600; letter-spacing: 1px; }

  /* Entrada: o card "trava" no alvo, como no Reels */
  .animar .card { animation: travar .7s cubic-bezier(.2, .9, .3, 1.2) .25s both; }
  .animar .card::before, .animar .card::after { animation: cantos .5s ease-out .7s both; }
  .animar .conectar { animation: surgir .4s ease-out .9s both; }
  @keyframes travar { from { opacity: 0; transform: scale(1.18); filter: blur(4px); } to { opacity: 1; transform: none; filter: none; } }
  @keyframes cantos { from { opacity: 0; width: 60px; height: 60px; } to { opacity: 1; } }
  @keyframes surgir { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (max-width: 420px) {
    .icone { width: 72px; height: 72px; }
    .nome { font-size: 21px; }
    .conectar { font-size: 17px; letter-spacing: 4px; }
  }
</style>
