---
import Elmo from './Elmo.astro';
import IconeDiscord from './IconeDiscord.astro';
import { servidor, links, vip } from '../data/servidor';

const paginas = [
  { href: '/', nome: 'Início' },
  { href: '/como-entrar/', nome: 'Como entrar' },
  { href: '/regras/', nome: 'Regras' },
  { href: '/vip/', nome: 'VIP' },
  { href: '/novidades/', nome: 'Novidades' },
];
const atual = Astro.url.pathname.replace(/\/?$/, '/');
const ativo = (href: string) => (href === '/' ? atual === '/' : atual.startsWith(href));
---
{servidor.preLancamento && (
  <div class="faixa">
    <div class="container faixa-in">
      <span>Abre dia {servidor.lancamentoCurto} · <b data-dias>em breve</b></span>
      <a href={links.direct} target="_blank" rel="noopener" data-copiar={vip.mensagemDirect} data-copiado="Mensagem copiada, cole no direct">Pré-venda do VIP aberta</a>
    </div>
  </div>
)}

<header class="topo">
  <div class="container topo-in">
    <a href="/" class="marca" aria-label="Invictus, página inicial">
      <span class="marca-icone"><Elmo largura={22} simples /></span>
      <span class="marca-nome">INVICTUS</span>
    </a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menu" data-menu>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    <nav id="menu" class="menu" aria-label="Principal">
      {paginas.map((p) => (
        <a href={p.href} aria-current={ativo(p.href) ? 'page' : undefined}>{p.nome}</a>
      ))}
      {servidor.ip ? (
        <button type="button" class="btn btn-vermelho conectar" data-copiar={servidor.ip} data-copiado="IP copiado">Conectar</button>
      ) : (
        <a class="btn btn-vermelho conectar discord" href={links.discord} target="_blank" rel="noopener" aria-label="Entrar no Discord do Invictus" title="Discord"><IconeDiscord tamanho={24} /><span class="so-menu">Entrar no Discord</span></a>
      )}
    </nav>
  </div>
</header>

<style>
  .faixa { background: var(--vermelho); font-size: 14px; font-weight: 600; letter-spacing: 1px; }
  .faixa-in { min-height: 36px; padding-block: 6px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 16px; }
  .faixa a { color: var(--branco); text-decoration: underline; }
  .topo { position: sticky; top: 0; z-index: 20; background: rgba(11, 11, 14, 0.88); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--linha); }
  .topo-in { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .marca { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--branco); }
  .marca-icone { width: 40px; height: 40px; background: var(--vermelho); display: grid; place-items: center; box-shadow: 0 0 18px rgba(255, 85, 85, 0.45); }
  .marca-nome { font-family: var(--f-marca); font-weight: 900; font-size: 21px; letter-spacing: 5px; }
  .menu { display: flex; align-items: center; gap: 26px; }
  .menu a { color: var(--texto-2); text-decoration: none; font-weight: 600; font-size: 14px; letter-spacing: 2px; text-transform: uppercase; padding: 10px 0; }
  .menu a:hover, .menu a[aria-current='page'] { color: var(--branco); }
  .menu a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--vermelho-jogo); }
  .conectar { min-height: 44px; padding: 0 20px; font-size: 13px; margin-left: 6px; }
  .discord { width: 52px; padding: 0; }
  .so-menu { display: none; }
  .menu-btn { display: none; width: 44px; height: 44px; background: transparent; border: 1px solid var(--linha); color: var(--branco); align-items: center; justify-content: center; cursor: pointer; }

  @media (max-width: 920px) {
    .menu-btn { display: flex; }
    .menu { display: none; position: absolute; left: 0; right: 0; top: 100%; flex-direction: column; align-items: stretch; gap: 0; background: var(--vazio); border-bottom: 1px solid var(--linha); padding: 8px 24px 24px; }
    .menu.aberto { display: flex; }
    .menu a { font-family: var(--f-titulo); font-weight: 900; font-size: 22px; letter-spacing: 1px; color: var(--branco); padding: 16px 0; border-bottom: 1px solid var(--linha); }
    .menu a[aria-current='page'] { box-shadow: none; color: var(--vermelho-jogo); }
    .conectar { margin: 20px 0 0; min-height: 52px; }
    .discord { width: auto; padding: 0 20px; }
    .so-menu { display: inline; }
  }
</style>
