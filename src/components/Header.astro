---
import Elmo from './Elmo.astro';
import { servidor, links, vip } from '../data/servidor';

const paginas = [
  { href: '/', nome: 'Início' },
  { href: '/como-entrar/', nome: 'Como entrar' },
  { href: '/regras/', nome: 'Regras' },
  { href: '/vip/', nome: 'VIP' },
  { href: '/novidades/', nome: 'Novidades' },
];
const atual = Astro.url.pathname.replace(/\/?$/, '/');
const ativo = (href: string) => (href === '/' ? atual === '/' : atual.startsWith(href));
---
<div class="faixa">
  <div class="container faixa-in">
    {servidor.preLancamento ? (
      <a href={links.direct} target="_blank" rel="noopener" data-copiar={vip.mensagemDirect} data-copiado="Mensagem copiada: cole no direct">Pré-venda do VIP aberta: garanta o seu antes do lançamento →</a>
    ) : (
      <span>Servidor aberto: entre com o IP <b class="mono">{servidor.ip}</b></span>
    )}
    <span>Lançamento: <b>{servidor.lancamentoTexto}</b> · <b class="mono" data-dias>{servidor.lancamentoCurto}</b></span>
  </div>
</div>

<header class="topo">
  <div class="container topo-in">
    <a href="/" class="marca" aria-label="Invictus, página inicial">
      <Elmo largura={30} simples />
      <span>INVICTUS</span>
    </a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menu" data-menu>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    <nav id="menu" class="menu" aria-label="Principal">
      {paginas.map((p) => (
        <a href={p.href} aria-current={ativo(p.href) ? 'page' : undefined}>{p.nome}</a>
      ))}
      <a href="/como-entrar/" class="btn blk btn-vermelho jogar">Jogar agora</a>
    </nav>
  </div>
</header>

<style>
  .faixa { background: var(--vermelho); font-size: 13px; font-weight: 600; }
  .faixa-in { padding-block: 8px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 16px; }
  .faixa a { color: var(--branco); text-decoration: underline; text-underline-offset: 3px; }
  .mono { font-family: var(--mono); }
  .topo { border-bottom: 1px solid #26262b; background: var(--fundo); position: relative; z-index: 10; }
  .topo-in { padding-block: 14px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .marca { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--branco); }
  .marca span { font-family: var(--titulo); font-weight: 900; font-size: 22px; letter-spacing: 5px; }
  .menu { display: flex; align-items: center; gap: 22px; }
  .menu a:not(.btn) { color: var(--texto-2); text-decoration: none; font-size: 15px; font-weight: 500; padding: 10px 2px; }
  .menu a:not(.btn):hover, .menu a[aria-current='page'] { color: var(--branco); }
  .menu a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--vermelho); }
  .jogar { padding: 12px 22px; margin-left: 8px; }
  .menu-btn { display: none; width: 44px; height: 44px; background: var(--fundo-2); border: 1px solid var(--linha); border-radius: 8px; color: var(--branco); align-items: center; justify-content: center; cursor: pointer; }

  @media (max-width: 900px) {
    .menu-btn { display: flex; }
    .menu { display: none; position: absolute; left: 0; right: 0; top: 100%; flex-direction: column; align-items: stretch; gap: 0; background: var(--preto); border-bottom: 1px solid var(--linha); padding: 8px 24px 20px; }
    .menu.aberto { display: flex; }
    .menu a:not(.btn) { font-family: var(--titulo); font-weight: 900; font-size: 24px; color: var(--branco); padding: 14px 0; border-bottom: 1px solid var(--linha); }
    .menu a[aria-current='page'] { box-shadow: none; color: var(--vermelho-claro); }
    .jogar { margin: 16px 0 0; }
  }
</style>
