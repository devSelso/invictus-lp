---
import Elmo from './Elmo.astro';
import { links, servidor } from '../data/servidor';
---
<footer class="rodape">
  <div class="container rodape-in">
    <div class="sobre">
      <span class="marca"><span class="marca-icone"><Elmo largura={18} simples /></span>INVICTUS</span>
      <p>Survival clássico na {servidor.versao}, com PvP, economia em Coins e VIP.</p>
      <p class="ip">IP <b>{servidor.ip}</b></p>
    </div>
    <nav aria-label="Rodapé" class="cols">
      <div><b>Jogar</b><a href="/como-entrar/">Como entrar</a><a href="/regras/">Regras</a></div>
      <div><b>Servidor</b><a href="/vip/">VIP</a><a href="/novidades/">Novidades</a></div>
      <div><b>Redes</b><a href={links.instagram} target="_blank" rel="noopener">Instagram</a><a href={links.tiktok} target="_blank" rel="noopener">TikTok</a></div>
    </nav>
  </div>
  <div class="container aviso">Não é um produto oficial do Minecraft. Não é aprovado nem associado à Mojang ou à Microsoft.</div>
  <div class="grama" aria-hidden="true"></div>
</footer>

<style>
  .rodape { margin-top: 120px; border-top: 1px solid var(--linha); background: rgba(11, 11, 14, 0.94); }
  .rodape-in { padding-block: 56px 40px; display: flex; flex-wrap: wrap; gap: 40px; justify-content: space-between; }
  .sobre { display: flex; flex-direction: column; gap: 12px; max-width: 380px; }
  .marca { display: flex; align-items: center; gap: 12px; font-family: var(--f-marca); font-weight: 900; font-size: 20px; letter-spacing: 5px; }
  .marca-icone { width: 34px; height: 34px; background: var(--vermelho); display: grid; place-items: center; }
  .sobre p { color: var(--texto-3); font-size: 15px; }
  .ip b { color: var(--vermelho-jogo); font-weight: 600; }
  .cols { display: flex; gap: 56px; flex-wrap: wrap; }
  .cols div { display: flex; flex-direction: column; gap: 10px; font-size: 15px; }
  .cols b { color: var(--texto-3); font-size: 12px; letter-spacing: 3px; text-transform: uppercase; }
  .cols a { color: var(--texto-2); text-decoration: none; }
  .cols a:hover { color: var(--vermelho-jogo); }
  .aviso { padding-block: 18px 28px; border-top: 1px solid var(--linha); color: var(--texto-3); font-size: 13px; }
</style>
